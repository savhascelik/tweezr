# Python
.venv/
__pycache__/
*.pyc

# scratch/ — üretilen her şey burada durur ve hiçbiri repoya girmez:
# test medyası, transkript çıktıları, kesilmiş klipler, indirilen korpus.
# Kodun ürettiği şeyi commit etmiyoruz; transcribe.py / verify_cut.py yeniden üretir.
scratch/*
!scratch/.gitkeep

# Kimlik bilgileri. db.py ve tone.py bunları ortam değişkenlerinden okuyor,
# hiçbiri kodda durmuyor.
.env
.env.*
!.env.example

# Editör ve OS gürültüsü
.vscode/
.idea/
.DS_Store
Thumbs.db

# Model önbelleği (yanlışlıkla proje içine inerse)
models/
*.bin
*.onnx

# Frontend bağımlılıkları ve build çıktısı. Sunucu web/dist'i servis ediyor ama
# derlenen şeyi commit etmiyoruz.
node_modules/
web/dist/
dist/

# SQLite oturum defteri. scratch/ altında ama açıkça yazıyoruz: bu dosya
# ziyaretçi oturumları ve kredi bakiyeleri tutuyor, repoya girmemeli.
*.db
*.db-wal
*.db-shm
