# Python
.venv/
__pycache__/
*.pyc

# scratch/ -- everything generated lands here and none of it enters the repo:
# test media, transcript output, cut clips, downloaded corpus.
# We do not commit what the code produces; transcribe.py / verify_cut.py regenerate it.
scratch/*
!scratch/.gitkeep

# Credentials. db.py and tone.py read these from the environment,
# none of them live in the code.
.env
.env.*
!.env.example

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Model cache (in case it lands inside the project by accident)
models/
*.bin
*.onnx

# web/ is served without a build step, so there is NO compiled output there and
# all of it is committed. These entries only exist in case a tool is added later.
node_modules/
dist/

# SQLite session ledger. It lives under scratch/ but is spelled out here too: this
# file holds visitor sessions and credit balances and must not enter the repo.
*.db
*.db-wal
*.db-shm
