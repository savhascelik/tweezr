<?xml version="1.0"?>
<!--
  Listen address fix for local development.

  In the 25.3 image config.xml leaves `127.0.0.1` and `::1` uncommented. IPv6 is
  disabled inside the container, so the `[::]` bind fails with "Address family for
  hostname not supported" and the server ends up listening on localhost only --
  unreachable from the host.

  replace="replace" does NOT append to the existing listen_host list, it replaces
  it. Appending would make 0.0.0.0 and 127.0.0.1 collide on the same port.

  This is for local Docker only. Not used on the Cloud Run / ClickHouse Cloud side.
-->
<clickhouse>
    <listen_host replace="replace">0.0.0.0</listen_host>
</clickhouse>
