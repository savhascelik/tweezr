# Virtualenv and build leftovers
.venv/
__pycache__/
*.pyc

# Development scratch. demo/ is NOT here: that is content and has to be in the image.
scratch/

# Credentials never enter the image. They arrive as environment variables.
.env
.env.*

# Git and editor
.git/
.gitignore
.vscode/
.idea/

# The local development ClickHouse is not used in production
dev/docker-compose.yml
dev/clickhouse-listen.xml

# The transcription stack does not run on the server
requirements-ingest.txt

# Tests are not needed in the image
**/test_*.py
**/test_*.mjs
