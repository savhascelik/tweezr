# Bu dosyayı .env olarak kopyalayıp doldur. .env gitignore'da.
# Kod bu değişkenleri ortamdan okuyor, hiçbir kimlik bilgisi kaynak kodda durmuyor.

# --- Gemini (ton sınıflandırması) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- ClickHouse ---
# Yerel geliştirme için hiçbirini doldurmana gerek yok; db.py varsayılan olarak
# dev/docker-compose.yml'deki konteynere bakıyor.
#
# ClickHouse Cloud için:
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=1
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cinema
