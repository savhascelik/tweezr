# Bu dosyayı .env olarak kopyalayıp doldur. .env gitignore'da.
# Kod bu değişkenleri ortamdan okuyor, hiçbir kimlik bilgisi kaynak kodda durmuyor.

# --- Gemini (ton sınıflandırması + sayfa içi asistan) ---
# https://aistudio.google.com/apikey
#
# Boş bırakabilirsin: arama, timeline, önizleme, provenance ve WebMCP araçları
# LLM olmadan çalışıyor. Anahtar sadece iki şeyi açıyor: ton sınıflandırması
# (pipeline/tone.py) ve sayfa içi asistan (server/agent.py).
GEMINI_API_KEY=

# Asistanın modeli. Anahtarında mevcut olduğunu doğrula.
AGENT_MODEL=gemini-2.5-flash

# Oturum başına sohbet mesajı sınırı. Kredi değil ayrı sayaç: sohbet bir LLM
# çağrısı, kredinin ölçtüğü render/ingest'ten farklı bir kaynak.
MAX_CHAT_MESSAGES=40

# --- ClickHouse ---
# Yerel geliştirme için hiçbirini doldurmana gerek yok; db.py varsayılan olarak
# dev/docker-compose.yml'deki konteynere bakıyor.
#
# ClickHouse Cloud için:
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=1
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cinema
