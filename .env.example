# Copy this file to .env and fill it in. .env is gitignored.
# The code reads these from the environment; no credential lives in the source.

# --- Gemini (tone classification + in-page assistant) ---
# https://aistudio.google.com/apikey
#
# You can leave it empty: search, timeline, preview, provenance and the WebMCP
# tools all work without an LLM. The key only unlocks two things: tone
# classification (pipeline/tone.py) and the in-page assistant (server/agent.py).
GEMINI_API_KEY=

# The assistant's model. Confirm it is available on your key.
AGENT_MODEL=gemini-2.5-flash

# Chat message limit per session. A separate counter, not credits: chat is an LLM
# call, a different resource from the render/ingest work credits measure.
MAX_CHAT_MESSAGES=40

# --- Uploads (bring your own footage) ---
# Transcription is CPU work with no upper bound of its own, so the brakes are on the
# input. Uploads need faster-whisper on the server; without it the endpoint reports
# itself off and the interface says so.
MAX_UPLOAD_MB=100
MAX_UPLOAD_SECONDS=180
MAX_UPLOADS_PER_SESSION=8

# The transcription model for uploads. Multilingual; an .en model would make the
# product silently English-only. `small` is better off English and about three times
# slower.
UPLOAD_MODEL=base

# Where uploaded media lands. Kept apart from the committed demo corpus, and pointed at
# /tmp in the container because the image layer is read-only there.
# UPLOAD_DIR=/tmp/uploads

# --- ClickHouse ---
# Nothing here needs filling in for local development; db.py points at the
# container from dev/docker-compose.yml by default.
#
# For ClickHouse Cloud:
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=1
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cinema
